<Window x:Class="Gadec.Common.Windows.Dialogs.ExceptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gadec.Common.Windows.Dialogs"
        mc:Ignorable="d"
        FontSize="14" FontFamily="Segoe UI Light"
        Title="ExceptionDialog" Height="350" Width="700" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"
                Margin="0,20,0,20"
                BorderThickness="1" BorderBrush="Black">
            <TextBlock x:Name="MessageTextBlock"
                       Margin="5" 
                       TextWrapping="Wrap"/>
        </Border>

        <Image Grid.Column="0" Grid.Row="1" 
               Width="100" Height="100"  
               Source="/Gadec.Common.Windows;component/Images/Warning.png" 
               Stretch="Fill" VerticalAlignment="Top"/>

        <Button x:Name="SendButton"
                Grid.Column="2" Grid.Row="2"
                Width="120" Margin="5,0"
                Content="Send" Click="SendButton_Click"/>
        <Button x:Name="CloseButton"
                Grid.Column="3" Grid.Row="2" 
                Width="120" Margin="5,0,0,0"
                Content="Close" Click="CloseButton_Click"/>
    </Grid>
</Window>
